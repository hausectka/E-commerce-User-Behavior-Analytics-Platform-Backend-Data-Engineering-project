# GCP credentials — NEVER commit this
dbt_project/gcp-key.json
dbt_project/**/*.json

# dbt build artifacts
dbt_project/my_dbt_project/target/
dbt_project/my_dbt_project/dbt_packages/
dbt_project/my_dbt_project/logs/
dbt_project/logs/

# dbt user config (machine-specific)
dbt_project/.dbt/.user.yml

# Airflow logs and data
airflow/logs/
airflow/data/

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo

# macOS
.DS_Store

# Environment files (contain secrets)
airflow/.env
